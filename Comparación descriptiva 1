  x = c(sum(datos24$anemia_oms2001 == "Sí", na.rm = TRUE),
        sum(datos24$anemia_oms2001 == "No", na.rm = TRUE)),
  n = nrow(datos24),
  conf.level = 0.95,
  methods = "wilson")
