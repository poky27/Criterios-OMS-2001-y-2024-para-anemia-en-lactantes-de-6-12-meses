##McNemar ----
df_pareado <- datos24 |>
  filter(!is.na(anemia_oms2001), !is.na(anemia_oms_tab2024))
tab_mcnemar <- table(
  OMS2001 = df_pareado$anemia_oms2001,
  OMS2024 = df_pareado$anemia_oms_tab2024
)

tab_mcnemar
b <- tab_mcnemar["Sí","No"]  # 2001 Sí, 2024 No
c <- tab_mcnemar["No","Sí"]  # 2001 No, 2024 Sí
discordantes <- b + c
discordantes
#Si b+c > 25 se aplica corrección de continuidad
mcnemar_cc <- mcnemar.test(tab_mcnemar, correct = TRUE)
mcnemar_cc

